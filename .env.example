# ========================================
# TEMPLATE FOR ALL ENVIRONMENTS
# ========================================
# Do NOT place real secrets in this file.
# Copy this file to .env or .env.local and fill in your real credentials.

# API & Frontend Configuration
VITE_API_URL="http://your-production-api-url"
PORT=3000

# Google Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# Email / SMTP Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your_app_password"
EMAIL_FROM="your-email@gmail.com"
EMAIL_TO="recipient-email@gmail.com"
